@inject SessionService Session
@inject IHirayaRepository Repository
@inject NavigationManager Nav

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="dashboard">
            <img class="nav-crest" src="images/hiraya-crest.png" alt="" />
            <span>Teacher workspace</span>
        </a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <SidebarUserCard />
    <nav class="nav flex-column">
        <div class="nav-item px-3"><NavLink class="nav-link" href="dashboard" Match="NavLinkMatch.All">Dashboard</NavLink></div>
        <p class="nav-group">Teaching</p>
        <div class="nav-item px-3"><NavLink class="nav-link" href="classes">My classes</NavLink></div>
        <div class="nav-item px-3"><NavLink class="nav-link" href="roster">Assigned students</NavLink></div>
        <div class="nav-item px-3"><NavLink class="nav-link" href="attendance">Attendance</NavLink></div>
        <div class="nav-item px-3"><NavLink class="nav-link" href="progress">Student progress</NavLink></div>
        <div class="nav-item px-3"><NavLink class="nav-link" href="schedules">Official schedule</NavLink></div>
        <div class="nav-item px-3"><NavLink class="nav-link" href="tasks">Weekly tasks</NavLink></div>
        <div class="nav-item px-3"><NavLink class="nav-link" href="modules">Learning modules</NavLink></div>
        <div class="nav-item px-3"><NavLink class="nav-link" href="calendar">Calendar</NavLink></div>
        <p class="nav-group">Inbox</p>
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="notifications">
                Notifications
                @if (unread > 0)
                {
                    <span class="nav-badge">@unread</span>
                }
            </NavLink>
        </div>
        <div class="nav-item px-3"><NavLink class="nav-link" href="announcements">Announcements</NavLink></div>
        <p class="nav-group">Account</p>
        <div class="nav-item px-3"><NavLink class="nav-link" href="settings/profile">My profile</NavLink></div>
        <div class="nav-item px-3"><NavLink class="nav-link" href="settings/account">Security</NavLink></div>
        <div class="nav-item px-3">
            <button class="nav-link nav-logout" type="button" @onclick="SignOut">Logout</button>
        </div>
    </nav>
</div>

@code {
    private int unread;

    protected override async Task OnParametersSetAsync()
    {
        if (Session.CurrentUser is null)
        {
            unread = 0;
            return;
        }

        var db = await Repository.LoadAsync();
        unread = NotificationService.UnreadCount(db, Session.CurrentUser);
    }

    private void SignOut()
    {
        Session.SignOut();
        Nav.NavigateTo("/");
    }
}
